			"email": "amaanq12@gmail.com"
		},
		{
			"name": "karl-police",
			"url": ""
		}
    ],
    "links": {
      "repository": "",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}