{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "luau",
      "camelcase": "Luau",
      "title": "Luau",
      "scope": "source.luau",
      "file-types": [
        "luau"
      ],
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm",
      "locals": "queries/locals.scm",
      "injection-regex": "^luau$",
      "class-name": "TreeSitterLuau"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Luau is a small, fast, and embeddable programming language based on Lua with a gradual type system.",
    "authors": [
